{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdc/listings.normalized.schema.json",
  "title": "listings.normalized",
  "description": "One listing after matching, with its cluster's price statistics: Gordon's to_scoring_rows(), published by adapters/matcher.py and read by the scorer (scorer_engine/models.py). Kafka key: cluster_id.",
  "type": "object",
  "required": [
    "cluster_id",
    "cluster_size",
    "cluster_platforms",
    "cluster_price_median_sgd",
    "cluster_price_min_sgd",
    "cluster_price_max_sgd",
    "listing_id",
    "source_platform",
    "source_listing_id",
    "title",
    "brand",
    "price_sgd",
    "seller_id",
    "seller_name",
    "seller_age_days",
    "rating",
    "review_count",
    "reviews",
    "product_url"
  ],
  "properties": {
    "cluster_id": {
      "type": "string",
      "minLength": 1
    },
    "cluster_size": {
      "type": "integer",
      "minimum": 1
    },
    "cluster_platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "cluster_price_median_sgd": {
      "type": "number",
      "minimum": 0
    },
    "cluster_price_min_sgd": {
      "type": "number",
      "minimum": 0
    },
    "cluster_price_max_sgd": {
      "type": "number",
      "minimum": 0
    },
    "listing_id": {
      "type": "string",
      "pattern": "^(Cartlane|Tao Market|Lazora):.+$"
    },
    "source_platform": {
      "$ref": "#/$defs/platform"
    },
    "source_listing_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "price_sgd": {
      "type": "number",
      "minimum": 0
    },
    "seller_id": {
      "type": "string",
      "minLength": 1
    },
    "seller_name": {
      "type": "string"
    },
    "seller_age_days": {
      "type": "integer"
    },
    "rating": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 5
    },
    "review_count": {
      "type": "integer",
      "minimum": 0
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "rating",
          "review_date"
        ],
        "properties": {
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "review_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "product_url": {
      "type": "string",
      "pattern": "^https?://"
    }
  },
  "$defs": {
    "platform": {
      "enum": [
        "Cartlane",
        "Tao Market",
        "Lazora"
      ]
    }
  }
}
